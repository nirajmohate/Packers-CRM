# Copy this file to .env.local and fill it in.

# Your MongoDB connection string. A local install or MongoDB Atlas both work.
#   local : mongodb://127.0.0.1:27017/packers_crm
#   Atlas : mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/packers_crm
MONGODB_URI=mongodb://127.0.0.1:27017/packers_crm

# A long random secret used to sign login cookies (at least 32 characters). Keep it private.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
